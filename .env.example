# ==========================================
# CareerAI by Axious Labs - Environment Config
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://careerai:careerai_secret@localhost:5432/careerai_db?schema=public

# Authentication (JWT)
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# Internal AI Services
AI_SERVICE_URL=http://localhost:8001
AGENT_SERVICE_URL=http://localhost:8002

# External AI & Search Providers (GenAI / Agentic)
GEMINI_API_KEY=your_gemini_api_key_here
REDIS_URL=redis://localhost:6379
VECTOR_DB_URL=http://localhost:8000
